<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UseRevitApi>true</UseRevitApi>
        <UseWPF>true</UseWPF>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\RevitMCP.Shared\RevitMCP.Shared.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Resource Include="Resources\*.png" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
        <!-- Pinned: every 2.1.x build of the native e_sqlite3 binary is affected by GHSA-2m69-gcr7-jv3q,
             and 3.x cannot be used because Microsoft.Data.Sqlite 8.x binds SQLitePCLRaw.core 2.x.
             The advisory requires hostile SQL input; this server only executes agent-authored SQL
             against a local project database. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
        <!-- Provided by the shared framework on .NET 10; referencing it there triggers NU1510. -->
        <PackageReference Include="System.Text.Json" Version="8.0.5" Condition="'$(TargetFramework)' != 'net10.0-windows'" />
    </ItemGroup>
</Project>
